{
  "manifest_version": 3,
  "name": "X Reply Copilot",
  "version": "1.6.0",
  "description": "在 X 上自动浏览时间线，用 DeepSeek 生成回复草稿，由你批准后发送。",
  "permissions": ["storage"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["defaults.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "X Reply Copilot 设置" }
}
